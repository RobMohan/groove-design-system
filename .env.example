# Copy to .env.local for local development (git-ignored). On Vercel, set the same
# names under Project Settings -> Environment Variables.

# Required for the docs chatbot. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5. A smaller model (for example claude-haiku-5-5)
# is much cheaper and is usually enough for docs Q&A.
# CHAT_MODEL=claude-opus-5-5

# Optional. Questions allowed per IP per 10 minutes, per server instance. Default 20.
# CHAT_RATE_LIMIT=20

# Optional. Extra origins allowed to call /api/chat besides the site itself (comma-separated).
# CHAT_ALLOWED_ORIGINS=
